<?xml version="1.0" encoding="utf-8"?>
<!-- Tests for protacoc and the C# runtime. Compiles generated .g.cs files with Protaco.cs, like a user project would.
     Output: bin\<Configuration>\protacoc.Tests.exe, next to protacoc.exe. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <BaseIntermediateOutputPath>..\..\..\.IntermediateDirectory\protacoc.Tests\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{8C2A4E6B-1D3F-4A5B-8C7D-9E0F1A2B3C4D}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>Protacoc.Tests</RootNamespace>
    <AssemblyName>protacoc.Tests</AssemblyName>
    <TargetFrameworkVersion>v4.6.1</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\..\..\bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>..\..\..\.IntermediateDirectory\protacoc.Tests\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\..\include\cs\Protaco.cs">
      <Link>include\cs\Protaco.cs</Link>
    </Compile>
    <Compile Include="..\taco_generated\cs\**\*.cs">
      <Link>taco_generated\cs\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\schemas\**\*.yaml">
      <Link>schemas\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
