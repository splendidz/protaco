<?xml version="1.0" encoding="utf-8"?>
<!-- C++ example using protacoc generated code. v141 x64, C++17. The only include path is the output folder (examples\taco_generated\cpp).
     A Pre-Build Event runs protacoc from bin\Release or bin\Debug (regenerates on yaml changes, leaves identical files untouched).
     Output: bin\<Configuration>\protaco_example.exe. Intermediates: .IntermediateDirectory\example\.
     Items are listed one file each: Visual Studio applies .vcxproj.filters to explicit items only. New schema or generated file: add its item and its filter. -->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>15.0</VCProjectVersion>
    <ProjectGuid>{4D9E1F60-2B37-4C8D-A5E6-7F8091A2B3C4}</ProjectGuid>
    <RootNamespace>ProtacoExample</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.17763.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v141</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\..\bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\..\.IntermediateDirectory\example\$(Configuration)\</IntDir>
    <TargetName>protaco_example</TargetName>
    <Protacoc Condition="Exists('$(ProjectDir)..\..\bin\Debug\protacoc.exe')">$(ProjectDir)..\..\bin\Debug\protacoc.exe</Protacoc>
    <Protacoc Condition="Exists('$(ProjectDir)..\..\bin\Release\protacoc.exe')">$(ProjectDir)..\..\bin\Release\protacoc.exe</Protacoc>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProjectDir)..\taco_generated\cpp;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
    <PreBuildEvent>
      <Command Condition="'$(Protacoc)'!=''">"$(Protacoc)" -I "$(ProjectDir)..\schemas" --cpp_out "$(ProjectDir)..\taco_generated\cpp" --cs_out "$(ProjectDir)..\taco_generated\cs"</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\schemas\Board.yaml" />
    <None Include="..\schemas\Category.yaml" />
    <None Include="..\schemas\Delivery.yaml" />
    <None Include="..\schemas\DeliveryProof.yaml" />
    <None Include="..\schemas\DeliveryRoute.yaml" />
    <None Include="..\schemas\Heartbeat.yaml" />
    <None Include="..\schemas\Limits.const.yaml" />
    <None Include="..\schemas\Menu.yaml" />
    <None Include="..\schemas\PizzaOrder.yaml" />
    <None Include="..\schemas\PizzaSize.enum.yaml" />
    <None Include="..\schemas\RouteStop.yaml" />
    <None Include="..\schemas\Spot.yaml" />
    <None Include="..\schemas\Topping.yaml" />
    <ClInclude Include="..\taco_generated\cpp\Board.g.h" />
    <ClInclude Include="..\taco_generated\cpp\Category.g.h" />
    <ClInclude Include="..\taco_generated\cpp\Delivery.g.h" />
    <ClInclude Include="..\taco_generated\cpp\DeliveryProof.g.h" />
    <ClInclude Include="..\taco_generated\cpp\DeliveryRoute.g.h" />
    <ClInclude Include="..\taco_generated\cpp\Heartbeat.g.h" />
    <ClInclude Include="..\taco_generated\cpp\Menu.g.h" />
    <ClInclude Include="..\taco_generated\cpp\PizzaOrder.g.h" />
    <ClInclude Include="..\taco_generated\cpp\RouteStop.g.h" />
    <ClInclude Include="..\taco_generated\cpp\Spot.g.h" />
    <ClInclude Include="..\taco_generated\cpp\Topping.g.h" />
    <ClInclude Include="..\taco_generated\cpp\PizzaSize.enum.h" />
    <ClInclude Include="..\taco_generated\cpp\Limits.const.h" />
    <ClInclude Include="..\taco_generated\cpp\Protaco.hpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
