<?xml version="1.0" encoding="utf-8"?>
<!-- C# example using protacoc generated code. .NET Framework 4.6.1, C# 7.3. Compiles examples\gen\cs (messages and Protaco.cs).
     Output: bin\<Configuration>\protaco_example_cs.exe. Intermediates: .IntermediateDirectory\example_cs\. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <BaseIntermediateOutputPath>..\..\.IntermediateDirectory\example_cs\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5E0A2C71-3D48-4E9F-B6A7-8091A2B3C4D5}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>ProtacoExample</RootNamespace>
    <AssemblyName>protaco_example_cs</AssemblyName>
    <TargetFrameworkVersion>v4.6.1</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>..\..\.IntermediateDirectory\example_cs\$(Configuration)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\gen\cs\*.cs">
      <Link>gen\cs\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\schemas\*.yaml">
      <Link>schemas\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
